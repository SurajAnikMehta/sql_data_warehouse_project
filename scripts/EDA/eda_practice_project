
--Understanding table structures, column definitions, and schemas before querying.

--Explore the metadata to see all user tables in the database.
SELECT 
    TABLE_CATALOG,
    TABLE_SCHEMA,
    TABLE_NAME,
    TABLE_TYPE
FROM INFORMATION_SCHEMA.TABLES;

-- Explor all columns in the database
SELECT 
    TABLE_NAME,
    COLUMN_NAME,
    DATA_TYPE,
    IS_NULLABLE
FROM INFORMATION_SCHEMA.COLUMNS
where TABLE_NAME = 'dim_customer'

select * from gold.dim_products  group by product_id having COUNT(*) >1 

-- Explore all unique countries where customers are based.
Select distinct country from gold.dim_customer order by 1

-- Explore all categories, subcategories, and distinct product lines available.
Select distinct category, subcategory, product_name
from gold.dim_products order by 1, 2, 3

-- Identifying operational boundaries, time horizons, and date spans.
Select 
    min (order_date) as first_order, 
    max (order_date) as last_order_date,
    datediff(YEAR, min(order_date), max(ship_date)) as order_range_years,
    datediff(MONTH, min(order_date), max(ship_date)) as order_range_months
from gold.fact_sales

-- Find the oldest and youngest customers based on birthdate.
select 
datediff(year,min(birthdate),GETDATE()) as oldest_cust,
datediff(year,max(birthdate),GETDATE()) as youngest_cust
from gold.dim_customer

--Find total sales, total items sold, average selling price, total orders placed, and distinct products sold.
Select 
    sum (sales_amount) as total_sales, 
    sum (quantity) as total_item_sold, 
    avg (price) as Average_price, 
    count (distinct order_num) as total_orders, 
from gold.fact_sales s
left join gold.dim_products p
on s.product_key = p.product_key





